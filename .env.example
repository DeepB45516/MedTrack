# MedTrack - LOCAL development settings.  Copy to .env:  cp .env.example .env
# (For Vercel use vercel.env instead.)

SECRET_KEY=change-me-to-a-long-random-string

# Leave DATABASE_URL unset to use the local SQLite file (database/medtrack.db).
# Set it to a Postgres/Supabase URL to use that database instead:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

APP_TIMEZONE=Asia/Kolkata

# Optional Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
